# Supabase — create a project at supabase.com, get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — get your API key at console.anthropic.com
ANTHROPIC_API_KEY=

# Twilio — get these from your Twilio console after buying a number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend — for sending emails (resend.com), verify your sending domain there
RESEND_API_KEY=

# The base URL of your deployed app, used for Twilio webhook callbacks
APP_BASE_URL=http://localhost:3000

# DANGER -- leave unset/false everywhere except your own local machine, and
# only when you deliberately want to view /dashboard without logging in.
# When "true", anyone who loads /dashboard with no session sees one real
# client's real data (no authentication). NEXT_PUBLIC_-prefixed so client
# components can read it too -- this also means its value is visible in the
# shipped browser bundle, not just on the server. Never set this in a
# deployed environment. DEMO_CLIENT_ID optionally pins which client to show;
# without it, 'Bracewell Flooring' is used.
NEXT_PUBLIC_DISABLE_AUTH_FOR_DEMO=false
DEMO_CLIENT_ID=
